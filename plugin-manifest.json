{
  "locale": [
    "en",
    "pt"
  ],
  "service": "DESK",
  "storage": true,
  "whiteListedDomains": [
    "https://api.paghiper.com",
    "https://sandbox.paghiper.com",
    "https://viacep.com.br",
    "https://desk.zoho.com"
  ],
  "modules": {
    "widgets": [
      {
        "location": "desk.ticket.detail.rightpanel",
        "url": "/app/widget.html",
        "name": "Boletos PagHiper",
        "logo": "/app/img/logo.png",
        "icon": "/app/img/icon.png"
      }
    ]
  },
  "zohoAuthorisation": {
    "type": "connectors",
    "connectionLinkName": "zohodesk_conn",
    "connectionName": "zohodesk_conn",
    "serviceName": "zlabs_integration",
    "userAccess": true,
    "isUserDefinedService": false,
    "scope": [
      "Desk.tickets.ALL",
      "Desk.contacts.READ",
      "Desk.contacts.UPDATE",
      "Desk.products.READ",
      "Desk.contracts.READ"
    ]
  },
  "connectors": [],
  "config": [
    {
      "name": "apiKey",
      "displayName": "PagHiper API Key",
      "mandatory": true,
      "secure": true,
      "type": "text",
      "userdefined": true,
      "authType": "org",
      "description": "Chave apk_ obtida em paghiper.com/painel/credenciais"
    },
    {
      "name": "token",
      "displayName": "PagHiper Token",
      "mandatory": true,
      "secure": true,
      "type": "text",
      "userdefined": true,
      "authType": "org",
      "description": "Token obtido em paghiper.com/painel/credenciais"
    },
    {
      "name": "diasVencimento",
      "displayName": "Dias para vencimento do boleto",
      "mandatory": false,
      "secure": false,
      "type": "text",
      "userdefined": true,
      "authType": "org",
      "default": "5"
    },
    {
      "name": "multa",
      "displayName": "Percentual de multa por atraso (1 ou 2)",
      "mandatory": false,
      "secure": false,
      "type": "text",
      "userdefined": true,
      "authType": "org"
    },
    {
      "name": "juros",
      "displayName": "Aplicar 1% de juros ao mês por atraso?",
      "mandatory": false,
      "secure": false,
      "type": "checkbox",
      "userdefined": true,
      "authType": "org"
    }
  ]
}
