// Sigma: crie/edite esta function com Return Type = String, nao Void.
// A Execution API com custom_response=true precisa retornar customResponse.

response = Map();
debug = Map();

requestData = Map();
payload = null;
try {
    requestData = data;
    payload = requestData.get("payload");
} catch (entradaError) {
    debug.put("entrada_normalizada", "data nao chegou como Map");
    debug.put("entrada_normalizada_erro", entradaError.toString());
    try {
        requestData = data.toMap();
        payload = requestData.get("payload");
    } catch (jsonEntradaError) {
        requestData = Map();
        requestData.put("payload", data);
        payload = data;
        debug.put("entrada_to_map_erro", jsonEntradaError.toString());
    }
}

if (payload == null) {
    payload = requestData.get("data");
}
if (payload != null) {
    try {
        payload = payload.toMap();
    } catch (payloadMapError) {
        debug.put("payload_ja_map_ou_nao_convertido", payloadMapError.toString());
    }
}
if (payload == null) {
    payload = requestData;
}

orgId = requestData.get("integ_scope_id");
if (orgId == null || orgId == "") {
    orgId = payload.get("org_id");
}

serviceDomain = requestData.get("service_domain");
if (serviceDomain == null || serviceDomain == "") {
    serviceDomain = "desk.zoho.com";
}
deskBaseUrl = serviceDomain;
if (deskBaseUrl.contains("http") == false) {
    deskBaseUrl = "https://" + serviceDomain;
}

installationId = requestData.get("service_app_id");
if (installationId == null || installationId == "") {
    installationId = requestData.get("app_install_id");
}

transactionId = payload.get("transaction_id");
ticketId = payload.get("ticket_id");
apiKey = payload.get("api_key");
token = payload.get("token");

debug.put("payload_detectado", payload != null);
debug.put("request_method", requestData.get("request_method"));
debug.put("org_id", orgId);
debug.put("service_domain", serviceDomain);
debug.put("desk_base_url", deskBaseUrl);
debug.put("service_app_id", installationId);
debug.put("sigma_execution_domain", requestData.get("sigma_execution_domain"));
debug.put("transaction_id", transactionId);
debug.put("ticket_id", ticketId);

apiKeyIndex = -1;
if (apiKey != null) {
    apiKey = apiKey.toString().trim();
    apiKeyLower = apiKey.toLowerCase();
    apiKeyIndex = apiKeyLower.indexOf("apk_");
    if (apiKeyIndex > 0) {
        apiKey = apiKey.subString(apiKeyIndex, apiKey.length());
    }
    if (apiKey.startsWith("APK_")) {
        apiKey = "apk_" + apiKey.subString(4, apiKey.length());
    }
}
if (token != null) {
    token = token.toString().trim();
}

credenciaisDebug = Map();
credenciaisDebug.put("api_key_preenchida", apiKey != null && apiKey != "");
credenciaisDebug.put("token_preenchido", token != null && token != "");
if (apiKey != null) {
    credenciaisDebug.put("api_key_tamanho", apiKey.length());
    credenciaisDebug.put("api_key_comeca_com_apk", apiKey.startsWith("apk_"));
    credenciaisDebug.put("api_key_posicao_apk_bruto", apiKeyIndex);
}
if (token != null) {
    credenciaisDebug.put("token_tamanho", token.length());
    credenciaisDebug.put("token_comeca_com_apk", token.startsWith("apk_"));
}
debug.put("credenciais_paghiper", credenciaisDebug);

if (transactionId == null || transactionId == "") {
    response.put("erro", "boleto_id_obrigatorio");
    response.put("mensagemAmigavel", "Informe o ID do boleto antes de consultar.");
    response.put("debug", debug);
    customResponse = Map();
    customResponse.put("statusCode", 200);
    customResponse.put("contentType", "application/json");
    customResponse.put("message", response);
    return customResponse;
}

if (apiKey == null || apiKey == "" || token == null || token == "") {
    response.put("erro", "plugin_nao_configurado");
    response.put("mensagemAmigavel", "Configure API Key e Token da PagHiper nas configuracoes da extensao.");
    response.put("debug", debug);
    customResponse = Map();
    customResponse.put("statusCode", 200);
    customResponse.put("contentType", "application/json");
    customResponse.put("message", response);
    return customResponse;
}

if (apiKey.startsWith("apk_") == false) {
    response.put("erro", "api_key_paghiper_invalida");
    response.put("mensagemAmigavel", "A API Key da PagHiper precisa comecar com apk_.");
    response.put("debug", debug);
    customResponse = Map();
    customResponse.put("statusCode", 200);
    customResponse.put("contentType", "application/json");
    customResponse.put("message", response);
    return customResponse;
}

payloadPagHiper = Map();
payloadPagHiper.put("apiKey", apiKey);
payloadPagHiper.put("token", token);
payloadPagHiper.put("transaction_id", transactionId);

debugPayload = Map();
debugPayload.putAll(payloadPagHiper);
debugPayload.put("apiKey", "****");
debugPayload.put("token", "****");
debug.put("paghiper_endpoint", "https://api.paghiper.com/transaction/status/");
debug.put("paghiper_payload", debugPayload);

try {
    respostaApi = invokeurl [
        url: "https://api.paghiper.com/transaction/status/"
        type: POST
        parameters: payloadPagHiper.toString()
        headers: {"Accept":"application/json"}
        content-type: "application/json"
    ];
    respostaMap = respostaApi.toMap();
    debug.put("paghiper_response", respostaMap);

    statusRequest = respostaMap.get("status_request");
    if (statusRequest != null && statusRequest.get("result") == "success") {
        response.put("status", statusRequest.get("status"));
        response.put("status_date", statusRequest.get("status_date"));
        response.put("due_date", statusRequest.get("due_date"));
        response.put("value_cents", statusRequest.get("value_cents"));
        valueCents = ifnull(statusRequest.get("value_cents"), "0");
        response.put("valor_total", (valueCents.toDecimal() / 100));
        response.put("transaction_id", transactionId);
        response.put("mensagemAmigavel", ifnull(statusRequest.get("response_message"), "Consulta realizada com sucesso."));

        bankSlip = statusRequest.get("bank_slip");
        if (bankSlip != null) {
            response.put("digitable_line", bankSlip.get("digitable_line"));
            response.put("url_slip", bankSlip.get("url_slip"));
            response.put("url_slip_pdf", bankSlip.get("url_slip_pdf"));
        }
    } else if (statusRequest != null) {
        response.put("erro", "recusa_gateway");
        response.put("mensagemAmigavel", "A PagHiper recusou a consulta: " + ifnull(statusRequest.get("response_message"), "verifique o ID do boleto."));
    } else if (respostaMap.containsKey("response_errors")) {
        erroObj = respostaMap.get("response_errors");
        response.put("erro", "recusa_gateway");
        response.put("mensagemAmigavel", "A PagHiper recusou a consulta: " + ifnull(erroObj.get("message"), "verifique o ID do boleto."));
    } else {
        response.put("erro", "resposta_invalida");
        response.put("mensagemAmigavel", "Retorno invalido da PagHiper ao consultar boleto.");
    }
} catch (e) {
    response.put("erro", "falha_comunicacao");
    response.put("mensagemAmigavel", "Falha de conexao com a PagHiper ao consultar boleto.");
    response.put("detalhe_tecnico", e.toString());
}

headersDesk = Map();
headersDesk.put("orgId", orgId);
headersDesk.put("Content-Type", "application/json");

if (response.containsKey("erro") == false && ticketId != null && ticketId != "") {
    try {
        cf = Map();
        cf.put("cf_id_do_boleto", response.get("transaction_id"));
        cf.put("cf_status_boleto", response.get("status"));
        cf.put("cf_link_do_boleto", response.get("url_slip"));
        cf.put("cf_linha_digitavel", response.get("digitable_line"));
        cf.put("cf_valor_do_servico", response.get("valor_total"));

        updatePayload = Map();
        updatePayload.put("cf", cf);
        updateTicket = invokeurl [
            url: deskBaseUrl + "/api/v1/tickets/" + ticketId
            type: PATCH
            parameters: updatePayload.toString()
            headers: headersDesk
            content-type: "application/json"
            connection: "zohodesk_conn"
        ];
        debug.put("desk_ticket_update", updateTicket);

        cfExtra = Map();
        if (response.get("url_slip_pdf") != null && response.get("url_slip_pdf") != "") {
            cfExtra.put("cf_link_pdf_boleto", response.get("url_slip_pdf"));
        }
        if (response.get("due_date") != null && response.get("due_date") != "") {
            cfExtra.put("cf_vencimento_boleto", response.get("due_date"));
        }
        if (response.get("status_date") != null && response.get("status_date") != "") {
            cfExtra.put("cf_data_status_boleto", response.get("status_date"));
        }
        if (cfExtra.size() > 0) {
            try {
                updateExtraPayload = Map();
                updateExtraPayload.put("cf", cfExtra);
                updateExtraTicket = invokeurl [
                    url: deskBaseUrl + "/api/v1/tickets/" + ticketId
                    type: PATCH
                    parameters: updateExtraPayload.toString()
                    headers: headersDesk
                    content-type: "application/json"
                    connection: "zohodesk_conn"
                ];
                debug.put("desk_ticket_update_extra", updateExtraTicket);
            } catch (extraFieldError) {
                debug.put("desk_update_extra_error", extraFieldError.toString());
            }
        }

        commentPayload = Map();
        commentPayload.put("content", "Consulta PagHiper: " + response.get("transaction_id") + " | Status: " + response.get("status"));
        commentPayload.put("isPublic", false);
        commentResponse = invokeurl [
            url: deskBaseUrl + "/api/v1/tickets/" + ticketId + "/comments"
            type: POST
            parameters: commentPayload.toString()
            headers: headersDesk
            content-type: "application/json"
            connection: "zohodesk_conn"
        ];
        debug.put("desk_comment", commentResponse);
    } catch (deskError) {
        debug.put("desk_update_error", deskError.toString());
    }
}

response.put("debug", debug);
customResponse = Map();
customResponse.put("statusCode", 200);
customResponse.put("contentType", "application/json");
customResponse.put("message", response);
return customResponse;
